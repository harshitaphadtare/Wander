# Optional: cloud sync between your phone and laptop (see docs/SETUP.md).
# Copy this file to .env.local and fill in both values. Leave empty to keep data on-device only.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Optional: your Cloudflare Worker URL (see docs/SETUP.md, step 4). Routes then use
# openrouteservice with your key. Leave empty to use the free keyless router.
VITE_API_URL=
