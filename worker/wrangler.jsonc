{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wander-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "vars": {
    // Add your deployed site URL here once you have it, e.g.
    // "http://localhost:5173,https://wander-xyz.vercel.app,https://wander-*-yourname.vercel.app"
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173,https://wander-one-eta.vercel.app,https://wander-*-harshitaphadtares-projects.vercel.app"
  },
  // Per-IP limits, so a script faking our Origin header can't drain the ORS / Gemini
  // quotas. A walk plan sends up to ~7 route requests at once; people never get near these.
  "ratelimits": [
    { "name": "ROUTE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "AI_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ]
  // Secrets (never in this file): `npx wrangler secret put ORS_API_KEY` and `npx wrangler secret put GEMINI_API_KEY`
  // For local `npm run dev`, put it in worker/.dev.vars (see .dev.vars.example).
}
